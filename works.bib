@book{5f0bcbe7dd58466b8374e34c077ac74d, title= {Wittgenstein: Two Source Catalogues and a Bibliography: Catalogues of the Published Texts and of the Published Diagrams, each Related to its Sources}, abstract= {Wittgenstein's published works have largely appeared as posthumous publications which have been edited by his trustees. We consider it useful to publish these catalogues of correspondences between the published material and the Nachlaß as a guide for scholars who wish to investigate the original manuscripts, which form the basis for the posthumous publications. The Nachlaß is taken as those writings which appear in G.H. von Wright's revised 1982 catalogue of the Wittgenstein Papers.}, author= {M. Biggs and Alois Pichler}, note= {reviewed by Erich Ammereller in: Philosophical Investigations 18(2) 173-177. Oxford, April 1995 ISSN 0190-0536 revised and translated into German in: Pichler, A. Untersuchungen zu Wittgensteins Nachlaß Skriftserie fra Wittgensteinarkivet ved Universitetet i Bergen, No.8, 189-231: Bergen, Norway, 1994. ISBN 82-91071-07-1 241pp.}, year= {1993}, isbn= {82-91071-06-3}, series= {Skriftserie fra Wittgensteinarkivet ved Universitetet i Bergen}, publisher= {University of Bergen}}

