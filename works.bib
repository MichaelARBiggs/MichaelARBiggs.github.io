@inproceedings{15af610c1f0446a1b7e157e9f4bdc927,
  title     = "A preliminary study of learnable pictogram languages",
  abstract  = "In 1930, Otto Neurath observed that graphic symbols could become a language with defined meanings that could be learned. In the case of English graphic symbols, people could easily learn to understand them. At first, there were around 850 English words that could be translated into graphic symbols. Since users have learned and developed them, pictographic systems of communication have become popular language in the world today (Hermann, 2003). Furthermore, Maurer (1985) points out that symbolic communication has existed and been developed for some time. Thus, pictogram language can be a learnable communication tool.",
  author    = "Ting-Ju Lin and M. Biggs",
  note      = "Original paper can be found at: http://www.iade.pt/drs2006/wonderground/proceedings/fullpapers/DRS2006\_0133.pdf",
  year      = "2006",
